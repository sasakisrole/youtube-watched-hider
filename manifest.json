{
  "manifest_version": 3,
  "name": "YouTube Watched Hider",
  "version": "1.44.0",
  "description": "YouTubeのおすすめから視聴済み動画を非表示にする拡張機能",
  "permissions": [
    "storage",
    "downloads",
    "alarms",
    "contextMenus",
    "offscreen"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "https://musicbrainz.org/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*"
      ],
      "js": [
        "content.js",
        "official_search_filter_core.js",
        "official_profile_store.js",
        "official_search_filter.js"
      ],
      "css": [
        "official_search_filter.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}